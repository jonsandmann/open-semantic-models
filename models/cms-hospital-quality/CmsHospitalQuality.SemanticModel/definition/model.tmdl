model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CmsBaseUrl","CalendarStart","CalendarEnd","GeneralInformation","ComplicationsAndDeaths","Fact Measure Result","Fact Overall Rating","Hospital","Quality Measure","Performance Date","Release Date"]

ref table 'Fact Measure Result'
ref table 'Fact Overall Rating'
ref table Hospital
ref table 'Quality Measure'
ref table 'Performance Date'
ref table 'Release Date'

ref expression CmsBaseUrl
ref expression CalendarStart
ref expression CalendarEnd
ref expression GeneralInformation
ref expression ComplicationsAndDeaths
