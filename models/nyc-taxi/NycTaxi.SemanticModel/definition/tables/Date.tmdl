/// Calendar dimension, one row per day from CalendarStart to CalendarEnd (whole years). Marked as the model's date table; drives year-to-date and prior-year measures.
table Date
	dataCategory: Time

	/// Calendar date. Primary key, related to Trips[Pickup Date].
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	/// Calendar year, for example 2025.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Quarter of the year as text, Q1 to Q4.
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

	/// Quarter of the year as a number, 1 to 4.
	column 'Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Quarter Number

	/// Year and quarter, for example 2025 Q1. Sorted by Year Quarter Number.
	column 'Year Quarter'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Quarter
		sortByColumn: 'Year Quarter Number'

	/// Sort key for Year Quarter: year times 10 plus quarter, for example 20251.
	column 'Year Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Quarter Number

	/// Full month name, January to December. Sorted by Month Number.
	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	/// Abbreviated month name, Jan to Dec. Sorted by Month Number.
	column 'Month Short'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Short
		sortByColumn: 'Month Number'

	/// Month of the year as a number, 1 to 12.
	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// Month and year, for example Jan 2025. Sorted by Year Month Number.
	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Number'

	/// Sort key for Year Month: year times 100 plus month, for example 202501.
	column 'Year Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Month Number

	/// Day of the month, 1 to 31.
	column 'Day of Month'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Day of Month

	/// Weekday name, Monday to Sunday. Sorted by Day of Week Number.
	column 'Day of Week'
		dataType: string
		summarizeBy: none
		sourceColumn: Day of Week
		sortByColumn: 'Day of Week Number'

	/// Weekday as a number, Monday = 1 to Sunday = 7 (ISO).
	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Day of Week Number

	/// Monday that starts the ISO week containing the date.
	column 'Week Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Week Start

	/// True on Saturday and Sunday.
	column 'Is Weekend'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Is Weekend

	/// True for every date on or before the last loaded pickup date, whether or not that day has trips: a cutoff, not a per-day flag. The prior-year measures shift only these dates back a year, so a period that runs past the loaded data (the current month, the current year) compares with the same span a year earlier. Kept contiguous on purpose: DATEADD needs an unbroken run of dates.
	column 'Through Last Trip Date' = 'Date'[Date] <= MAX ( Trips[Pickup Date] )
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none

	partition Date = m
		mode: import
		source =
			let
				DayCount = Duration.Days(CalendarEnd - CalendarStart) + 1,
				Dates = List.Dates(CalendarStart, DayCount, #duration(1, 0, 0, 0)),
				Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				AddQuarterNumber = Table.AddColumn(AddYear, "Quarter Number", each Date.QuarterOfYear([Date]), Int64.Type),
				AddQuarter = Table.AddColumn(AddQuarterNumber, "Quarter", each "Q" & Text.From([Quarter Number]), type text),
				AddYearQuarter = Table.AddColumn(AddQuarter, "Year Quarter", each Text.From([Year]) & " Q" & Text.From([Quarter Number]), type text),
				AddYearQuarterNumber = Table.AddColumn(AddYearQuarter, "Year Quarter Number", each [Year] * 10 + [Quarter Number], Int64.Type),
				AddMonthNumber = Table.AddColumn(AddYearQuarterNumber, "Month Number", each Date.Month([Date]), Int64.Type),
				AddMonth = Table.AddColumn(AddMonthNumber, "Month", each Date.ToText([Date], [Format = "MMMM", Culture = "en-US"]), type text),
				AddMonthShort = Table.AddColumn(AddMonth, "Month Short", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
				AddYearMonth = Table.AddColumn(AddMonthShort, "Year Month", each Date.ToText([Date], [Format = "MMM yyyy", Culture = "en-US"]), type text),
				AddYearMonthNumber = Table.AddColumn(AddYearMonth, "Year Month Number", each [Year] * 100 + [Month Number], Int64.Type),
				AddDayOfMonth = Table.AddColumn(AddYearMonthNumber, "Day of Month", each Date.Day([Date]), Int64.Type),
				AddDayOfWeek = Table.AddColumn(AddDayOfMonth, "Day of Week", each Date.DayOfWeekName([Date], "en-US"), type text),
				AddDayOfWeekNumber = Table.AddColumn(AddDayOfWeek, "Day of Week Number", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				AddWeekStart = Table.AddColumn(AddDayOfWeekNumber, "Week Start", each Date.StartOfWeek([Date], Day.Monday), type date),
				AddWeekend = Table.AddColumn(AddWeekStart, "Is Weekend", each [Day of Week Number] >= 6, type logical)
			in
				AddWeekend
