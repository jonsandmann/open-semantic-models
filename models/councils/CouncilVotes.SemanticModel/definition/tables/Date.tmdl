/// Meeting calendar: one row per day from 1 November 2025 to 31 December 2026 (the window is 24 Nov 2025 to 24 Nov 2026). Marked as the model's date table. Related to the meeting date on all three facts (meetings, agenda items, member votes), so a slicer here means "at meetings held that day".
table Date
	dataCategory: Time

	/// Calendar date. Primary key, related to the Meeting Date column of each fact.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	/// Calendar year, for example 2026.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Quarter of the year as text, Q1 to Q4. Sorted by Quarter Number.
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter
		sortByColumn: 'Quarter Number'

	/// Quarter of the year as a number, 1 to 4.
	column 'Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Quarter Number

	/// Year and quarter, for example 2026 Q3. Sorted by Year Quarter Number.
	column 'Year Quarter'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Quarter
		sortByColumn: 'Year Quarter Number'

	/// Sort key for Year Quarter: year times 10 plus quarter.
	column 'Year Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Quarter Number

	/// Full month name, January to December. Sorted by Month Number.
	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	/// Abbreviated month name, Jan to Dec. Sorted by Month Number.
	column 'Month Short'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Short
		sortByColumn: 'Month Number'

	/// Month of the year as a number, 1 to 12.
	column 'Month Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// Year and month as YYYY-MM. Sorted by Year Month Sort.
	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Sort'

	/// Sort key for Year Month: year times 100 plus month.
	column 'Year Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Month Sort

	/// First day of the month the date falls in.
	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Month Start

	partition Date = m
		mode: import
		source = Calendar
