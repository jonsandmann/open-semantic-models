/// Folder holding the data factory's three joined Parquet files (establishments.parquet, inspections.parquet, violations.parquet from data-factory/inspections/data/). The dataset has no public URL, so the files are copied to a lake folder: an Azure Data Lake Storage Gen2 or OneLake folder URL, https://onelake.dfs.fabric.microsoft.com/<workspace id>/<lakehouse id>/Files/<folder>. The default is the Semantic Models Lab workspace's InspectionsData lakehouse. To read a folder on disk in Power BI Desktop instead, change the one connector line in InspectionFiles to Folder.Files ( InspectionsFolder ) and set this to the local path.
expression InspectionsFolder = "https://onelake.dfs.fabric.microsoft.com/<workspace-id>/<lakehouse-id>/Files/inspections" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

/// Shared query, not loaded: the files in InspectionsFolder (Name and Content). The only connector in the model, so pointing the model at another folder or another kind of folder is a one-line change here (AzureStorage.DataLake for a lake folder, Folder.Files for a local one; both return Name and Content).
expression InspectionFiles =
		let
			Files = AzureStorage.DataLake(InspectionsFolder, [HierarchicalNavigation = false]),
			Kept = Table.SelectColumns(Files, {"Name", "Content"})
		in
			Kept
	annotation PBI_ResultType = Table

/// Shared query, not loaded: one calendar day per row from 1 January 2023 to 31 December 2026, the span the data factory fetched (the earliest inspection is 2 January 2023; Delaware publishes two inspections dated December 2026). Loaded by the Date table.
expression Calendar =
		let
			CalendarStart = #date(2023, 1, 1),
			CalendarEnd = #date(2026, 12, 31),
			DayCount = Duration.Days(CalendarEnd - CalendarStart) + 1,
			Dates = List.Dates(CalendarStart, DayCount, #duration(1, 0, 0, 0)),
			Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
			AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
			AddQuarterNumber = Table.AddColumn(AddYear, "Quarter Number", each Date.QuarterOfYear([Date]), Int64.Type),
			AddQuarter = Table.AddColumn(AddQuarterNumber, "Quarter", each "Q" & Text.From([Quarter Number]), type text),
			AddYearQuarter = Table.AddColumn(AddQuarter, "Year Quarter", each Text.From([Year]) & " Q" & Text.From([Quarter Number]), type text),
			AddYearQuarterNumber = Table.AddColumn(AddYearQuarter, "Year Quarter Number", each [Year] * 10 + [Quarter Number], Int64.Type),
			AddMonthNumber = Table.AddColumn(AddYearQuarterNumber, "Month Number", each Date.Month([Date]), Int64.Type),
			AddMonth = Table.AddColumn(AddMonthNumber, "Month", each Date.ToText([Date], [Format = "MMMM", Culture = "en-US"]), type text),
			AddMonthShort = Table.AddColumn(AddMonth, "Month Short", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
			AddYearMonth = Table.AddColumn(AddMonthShort, "Year Month", each Text.From([Year]) & "-" & Text.PadStart(Text.From([Month Number]), 2, "0"), type text),
			AddYearMonthSort = Table.AddColumn(AddYearMonth, "Year Month Sort", each [Year] * 100 + [Month Number], Int64.Type),
			AddMonthStart = Table.AddColumn(AddYearMonthSort, "Month Start", each Date.StartOfMonth([Date]), type date),
			AddSeason = Table.AddColumn(AddMonthStart, "Season", each if List.Contains({12, 1, 2}, [Month Number]) then "Dec-Feb" else if [Month Number] <= 5 then "Mar-May" else if [Month Number] <= 8 then "Jun-Aug" else "Sep-Nov", type text),
			AddSeasonSort = Table.AddColumn(AddSeason, "Season Sort", each if List.Contains({12, 1, 2}, [Month Number]) then 1 else if [Month Number] <= 5 then 2 else if [Month Number] <= 8 then 3 else 4, Int64.Type)
		in
			AddSeasonSort
	annotation PBI_ResultType = Table
