/// Calendar dimension, one row per day from 1 January FirstYear to 31 December LastYear. Marked as the model's date table. Related to 'Fact Detection'[Acq Date], the UTC date of the satellite acquisition: not Portugal's local date (a detection at 23:30 UTC in summer is already the next day locally). There is no second date.
table Date
	dataCategory: Time

	/// Calendar date (UTC). Primary key, related to 'Fact Detection'[Acq Date].
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	/// Calendar year, for example 2026.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Quarter of the year as text, Q1 to Q4. Sorted by Quarter Number.
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter
		sortByColumn: 'Quarter Number'

	/// Quarter of the year as a number, 1 to 4.
	column 'Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Quarter Number

	/// Year and quarter, for example 2026 Q3. Sorted by Year Quarter Number.
	column 'Year Quarter'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Quarter
		sortByColumn: 'Year Quarter Number'

	/// Sort key for Year Quarter: year times 10 plus quarter, for example 20263.
	column 'Year Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Quarter Number

	/// Full month name, January to December. Sorted by Month Number.
	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	/// Abbreviated month name, Jan to Dec. Sorted by Month Number.
	column 'Month Short'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Short
		sortByColumn: 'Month Number'

	/// Month of the year as a number, 1 to 12.
	column 'Month Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// Year and month as YYYY-MM, for example 2026-08. Sorted by Year Month Sort.
	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Sort'

	/// Sort key for Year Month: year times 100 plus month, for example 202608.
	column 'Year Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Year Month Sort

	/// First day of the month the date falls in.
	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Month Start

	partition Date = m
		mode: import
		source = Calendar
