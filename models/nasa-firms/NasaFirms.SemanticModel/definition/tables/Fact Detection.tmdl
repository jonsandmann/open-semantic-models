/// Fact table: NASA FIRMS active-fire detections from the country yearly archive files, one row per detection (one satellite pixel on one overpass) for each product, country and year loaded. A detection is not a fire: the same fire is seen again on the next overpass and by the other satellites, so the three products are never added (the source rule in every measure). Every column is hidden; analysis goes through the measures and the dimensions. Source: NASA LANCE FIRMS, CC0 with a requested citation (the Citation measure).
table 'Fact Detection'

	/// Detections under the source rule: VIIRS NOAA-20 when no source or satellite is picked, the one source picked, or blank when two or three sources are picked (adding products counts the same fire two or three times).
	measure Detections =
			VAR Picked = ISFILTERED ( Source ) || ISFILTERED ( Satellite )
			VAR SourceCount = COUNTROWS ( INTERSECT ( VALUES ( Source[Source] ), VALUES ( Satellite[Source] ) ) )
			RETURN
				SWITCH (
					TRUE (),
					NOT Picked, CALCULATE ( COUNTROWS ( 'Fact Detection' ), Source[Source] = "VIIRS NOAA-20" ),
					SourceCount = 1, COUNTROWS ( 'Fact Detection' )
				)
		formatString: #,0
		displayFolder: Detections

	/// Detections of the one source in context, for a matrix with Source on rows. Blank wherever more than one source is in context, including the matrix total and an unfiltered card, so the three rows are never summed.
	measure 'Detections in source' =
			IF (
				COUNTROWS ( INTERSECT ( VALUES ( Source[Source] ), VALUES ( Satellite[Source] ) ) ) = 1,
				COUNTROWS ( 'Fact Detection' )
			)
		formatString: #,0
		displayFolder: Detections

	/// Detections of presumed vegetation fires (hotspot type 0), under the source rule.
	measure 'Vegetation detections' = CALCULATE ( [Detections], KEEPFILTERS ( 'Hotspot Type'[Type Code] = "0" ) )
		formatString: #,0
		displayFolder: Detections

	/// High-confidence detections (VIIRS h, MODIS 80 and over), under the source rule.
	measure 'High confidence detections' = CALCULATE ( [Detections], KEEPFILTERS ( 'Confidence Band'[Confidence Band] = "High" ) )
		formatString: #,0
		displayFolder: Detections

	/// High-confidence detections as a share of detections, same source on both sides.
	measure 'High confidence share' = DIVIDE ( [High confidence detections], [Detections] )
		formatString: 0.0%
		displayFolder: Detections

	/// Daytime detections (the satellite's day flag) as a share of detections, same source on both sides.
	measure 'Day share' = DIVIDE ( CALCULATE ( [Detections], KEEPFILTERS ( 'Day Night'[Day Night] = "Day" ) ), [Detections] )
		formatString: 0.0%
		displayFolder: Detections

	/// Satellites with a detection in context, under the source rule: 1 for NOAA-20 or S-NPP, up to 2 for MODIS (Terra and Aqua).
	measure 'Satellites in scope' =
			VAR Picked = ISFILTERED ( Source ) || ISFILTERED ( Satellite )
			VAR SourceCount = COUNTROWS ( INTERSECT ( VALUES ( Source[Source] ), VALUES ( Satellite[Source] ) ) )
			RETURN
				SWITCH (
					TRUE (),
					NOT Picked, CALCULATE ( DISTINCTCOUNT ( 'Fact Detection'[Satellite] ), Source[Source] = "VIIRS NOAA-20" ),
					SourceCount = 1, DISTINCTCOUNT ( 'Fact Detection'[Satellite] )
				)
		formatString: 0
		displayFolder: Detections

	/// Sum of pixel fire radiative power in megawatts, under the source rule. A sum over pixels and overpasses, not the power of distinct fires; VIIRS and MODIS totals are not comparable (different pixel sizes).
	measure 'Total FRP' =
			VAR Picked = ISFILTERED ( Source ) || ISFILTERED ( Satellite )
			VAR SourceCount = COUNTROWS ( INTERSECT ( VALUES ( Source[Source] ), VALUES ( Satellite[Source] ) ) )
			RETURN
				SWITCH (
					TRUE (),
					NOT Picked, CALCULATE ( SUM ( 'Fact Detection'[FRP] ), Source[Source] = "VIIRS NOAA-20" ),
					SourceCount = 1, SUM ( 'Fact Detection'[FRP] )
				)
		formatString: #,0.0
		displayFolder: FRP

	/// Mean FRP per detection in megawatts, under the source rule. The mean of pixels, not the power of a fire.
	measure 'Average FRP' = DIVIDE ( [Total FRP], [Detections] )
		formatString: 0.00
		displayFolder: FRP

	/// FRP of presumed vegetation fires (hotspot type 0), under the source rule.
	measure 'Vegetation FRP' = CALCULATE ( [Total FRP], KEEPFILTERS ( 'Hotspot Type'[Type Code] = "0" ) )
		formatString: #,0.0
		displayFolder: FRP

	/// Latest acquisition date in the model, ignoring every filter. The year-to-date and prior-year measures read it.
	measure 'Last Acq Date' = CALCULATE ( MAX ( 'Fact Detection'[Acq Date] ), REMOVEFILTERS () )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: Time

	/// Detections year to date by UTC acquisition date, under the source rule. Blank for a period that starts after the last acquisition date loaded.
	measure 'Detections YTD' = IF ( MIN ( 'Date'[Date] ) <= [Last Acq Date], TOTALYTD ( [Detections], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Time

	/// Detections in the same period one year earlier (UTC acquisition date), over the same days that have data now, under the source rule.
	measure 'Detections prior year' =
			VAR LastDay = [Last Acq Date]
			RETURN
				CALCULATE ( [Detections], SAMEPERIODLASTYEAR ( FILTER ( VALUES ( 'Date'[Date] ), 'Date'[Date] <= LastDay ) ) )
		formatString: #,0
		displayFolder: Time

	/// Change in detections against the same period a year earlier, as a percentage of the prior year.
	measure 'Detections YoY %' = IF ( NOT ISBLANK ( [Detections] ), DIVIDE ( [Detections] - [Detections prior year], [Detections prior year] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time

	/// Total FRP in the same period one year earlier, over the same days that have data now, under the source rule.
	measure 'FRP prior year' =
			VAR LastDay = [Last Acq Date]
			RETURN
				CALCULATE ( [Total FRP], SAMEPERIODLASTYEAR ( FILTER ( VALUES ( 'Date'[Date] ), 'Date'[Date] <= LastDay ) ) )
		formatString: #,0.0
		displayFolder: Time

	/// Change in total FRP against the same period a year earlier, as a percentage of the prior year.
	measure 'FRP YoY %' = IF ( NOT ISBLANK ( [Total FRP] ), DIVIDE ( [Total FRP] - [FRP prior year], [FRP prior year] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time

	/// The UTC acquisition date in context with the most detections, under the source rule. On a tie, the latest of the tied dates.
	measure 'Peak day' =
			IF (
				NOT ISBLANK ( [Detections] ),
				MAXX ( TOPN ( 1, VALUES ( 'Date'[Date] ), [Detections] ), 'Date'[Date] )
			)
		formatString: yyyy-mm-dd
		displayFolder: Time

	/// Detections on the peak day, under the source rule.
	measure 'Peak day detections' =
			VAR PeakDate = [Peak day]
			RETURN
				IF ( NOT ISBLANK ( PeakDate ), CALCULATE ( [Detections], 'Date'[Date] = PeakDate ) )
		formatString: #,0
		displayFolder: Time

	/// Detections of other static land sources (hotspot type 2: gas flares, industrial heat), under the source rule. Included in Detections.
	measure 'Static land detections' = CALCULATE ( [Detections], KEEPFILTERS ( 'Hotspot Type'[Type Code] = "2" ) )
		formatString: #,0
		displayFolder: Audit

	/// Low-confidence detections (VIIRS l, MODIS under 30), under the source rule. Included in Detections.
	measure 'Low confidence detections' = CALCULATE ( [Detections], KEEPFILTERS ( 'Confidence Band'[Confidence Band] = "Low" ) )
		formatString: #,0
		displayFolder: Audit

	/// Every detection row in context, all sources added. Audit only: it counts the same fire once per product that saw it.
	measure 'All product rows' = COUNTROWS ( 'Fact Detection' )
		formatString: #,0
		isHidden
		displayFolder: Audit

	/// The citation NASA asks for on anything built from FIRMS data. Put it on every report page.
	measure Citation = "We acknowledge the use of data and/or imagery from NASA's Fire Information for Resource Management System (FIRMS) (https://www.earthdata.nasa.gov/firms), part of NASA's Earth Science Data and Information System (ESDIS). Data: NASA LANCE FIRMS country yearly active-fire CSVs (MODIS C6.1, VIIRS S-NPP, VIIRS NOAA-20)."
		formatString: @
		displayFolder: About

	/// NASA's disclaimer for LANCE and FIRMS data, which NASA asks to be carried with the data.
	measure Disclaimer = "The LANCE system is operated by the NASA/GSFC Earth Science Data and Information System (ESDIS). The information presented through LANCE, Rapid Response, GIBS, Worldview, and FIRMS are provided ""as is"" and users bear all responsibility and liability for their use of data. Full disclaimer: https://www.earthdata.nasa.gov/data/tools/firms"
		formatString: @
		displayFolder: About

	/// Source, acquisition date, time, latitude and longitude joined with "|". Unique in the loaded files.
	column 'Detection Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Detection Key

	/// UTC calendar date of the acquisition, not Portugal's local date (UTC+1 in summer). Foreign key to 'Date'[Date].
	column 'Acq Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Acq Date

	/// Acquisition time, HHMM UTC. Text, not a date.
	column 'Acq Time'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Acq Time

	/// Product: VIIRS NOAA-20, VIIRS S-NPP or MODIS, from the file. Foreign key to Source[Source].
	column Source
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Source

	/// Satellite code: N20, N, Terra, Aqua. Foreign key to Satellite[Satellite].
	column Satellite
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Satellite

	/// Country of the file. Foreign key to Country[Country].
	column Country
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Country

	/// Pixel centre latitude, WGS84, kept to four decimals (about 11 m; the pixel is 375 m or 1 km).
	column Latitude
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: 0.0000
		summarizeBy: none
		dataCategory: Latitude
		sourceColumn: Latitude

	/// Pixel centre longitude, WGS84, kept to four decimals.
	column Longitude
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: 0.0000
		summarizeBy: none
		dataCategory: Longitude
		sourceColumn: Longitude

	/// Fire radiative power of the pixel in megawatts. Read through Total FRP and Average FRP.
	column FRP
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: FRP

	/// Confidence as published: VIIRS l, n or h; MODIS 0 to 100.
	column Confidence
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Confidence

	/// Low, Nominal or High on one scale for both instruments. Foreign key to 'Confidence Band'[Confidence Band].
	column 'Confidence Band'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Confidence Band

	/// Day or Night (the satellite's flag). Foreign key to 'Day Night'[Day Night].
	column 'Day Night'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Day Night

	/// Hotspot type code 0 to 3. Foreign key to 'Hotspot Type'[Type Code].
	column 'Type Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Type Code

	/// Brightness temperature in kelvin (VIIRS I-4 channel, MODIS channel 21/22). Not comparable across instruments.
	column Brightness
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: 0.00
		summarizeBy: none
		sourceColumn: Brightness

	partition 'Fact Detection' = m
		mode: import
		source = Table.SelectColumns(FirmsDetections, {"Detection Key", "Acq Date", "Acq Time", "Source", "Satellite", "Country", "Latitude", "Longitude", "FRP", "Confidence", "Confidence Band", "Day Night", "Type Code", "Brightness"})
